{
  "manifest_version": 3,
  "name": "bilifast 播放加速",
  "version": "0.1.1",
  "description": "B 站网页播放器多路并发预读：4K、倍速、跳转都不卡。不需要安装其他程序。",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "content_scripts": [{
    "matches": ["https://www.bilibili.com/video/*", "https://www.bilibili.com/list/*", "https://www.bilibili.com/bangumi/play/*",
                "https://www.bilibili.com/*/video/*", "https://www.bilibili.com/*/list/*", "https://www.bilibili.com/*/bangumi/play/*"],
    "js": ["page.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }, {
    "matches": ["https://www.bilibili.com/video/*", "https://www.bilibili.com/list/*", "https://www.bilibili.com/bangumi/play/*",
                "https://www.bilibili.com/*/video/*", "https://www.bilibili.com/*/list/*", "https://www.bilibili.com/*/bangumi/play/*"],
    "js": ["bridge.js"],
    "run_at": "document_start"
  }]
}
